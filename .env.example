# Existing
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Supabase Edge Function secret (set via `supabase secrets set`, not in the client .env)
OPEN_CHARGE_MAP_API_KEY=

# Optional new sources used by the `sync-ev-stations` Edge Function.
# Leave blank to skip that source; the sync still works with the keyless ones.

# OpenEV - Delhi Transport (live per-connector availability + tariffs)
# Register at https://openev.delhitransport.in/documentation/
OPEN_EV_API_KEY=

# Google Places API (New) - evChargeOptions live connector availability.
# Billed at the Enterprise + Atmosphere SKU.
GOOGLE_MAPS_API_KEY=

# Generic OCPI 2.2.1 locations feed (IONAGE / ChargeID / EVnnovator / One Bharat Charge)
# OCPI_TOKEN is sent as `Authorization: Token <value>`.
OCPI_LOCATIONS_URL=
OCPI_TOKEN=

# Optional Overpass endpoint override for the OpenStreetMap source (keyless by default).
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
