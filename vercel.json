{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "crons": [
    {
      "path": "/api/sync-ev-stations?mode=full&maxPagesPerState=2",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/enrich-place-photos?limit=100",
      "schedule": "0 4 * * *"
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
